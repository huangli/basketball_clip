# Python 虚拟环境
.venv*/

# 运行时中间产物与成品
work/
output/

# 模型权重（不随仓库分发）
models/

# Python 字节码
__pycache__/
*.pyc

# 打包产物与干净房间测试目录
packaging/**/build/
packaging/**/dist/
packaging/**/cleanroom/
# 打包资产（~500MB+ 下载产物，fetch_assets.py 可重建）与构建日志
packaging/assets/
packaging/build.log
/dist/
/build/

# 工具缓存
.pytest_cache/
.ruff_cache/

# 本地 SDD 过程稿（含私人上下文，永不入库）
.superpowers/
